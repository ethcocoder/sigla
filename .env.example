# Managed runtime values are injected by the platform where available.
EXPO_PUBLIC_API_BASE_URL=

# Supabase public client configuration. These values are safe for the client only when
# paired with strict RLS; never put a service-role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon-key name is accepted for compatibility if the selected project uses it.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-only values: configure through protected secret input in the managed project.
# SUPABASE_SERVICE_ROLE_KEY=
# TELEBIRR_VERIFICATION_WEBHOOK_SECRET=
