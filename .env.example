# Public Firebase web config is embedded in lib/firebase.ts for the SIGLA project.
EXPO_PUBLIC_API_BASE_URL=

# Server/CLI only. Never commit this file or the JSON service-account key.
FIREBASE_SERVICE_ACCOUNT=/absolute/path/to/sigla-1e1cf-firebase-adminsdk.json
ADMIN_EMAIL=
# Required only when seed-admin must create a new Auth user.
ADMIN_PASSWORD=
ADMIN_NAME=SIGLA Administrator
ADMIN_PHONE=
