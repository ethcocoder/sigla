rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function owner(userId) { return signedIn() && request.auth.uid == userId; }
    function activeUser() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'ACTIVE'; }

    match /users/{userId} {
      allow read: if owner(userId) || admin();
      allow create: if owner(userId);
      allow update: if owner(userId) || admin();
      allow delete: if admin();
    }
    match /posts/{postId} {
      allow read: if resource.data.status == 'APPROVED' || (signedIn() && resource.data.userId == request.auth.uid) || admin();
      allow create: if activeUser() && request.resource.data.userId == request.auth.uid;
      allow update: if admin() || (activeUser() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid);
      allow delete: if admin() || (activeUser() && resource.data.userId == request.auth.uid);
    }
    match /payments/{paymentId} {
      allow read: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if admin();
      allow delete: if admin();
    }
    match /notifications/{notificationId} {
      allow read, update: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, delete: if admin();
    }
    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds;
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.receiverId in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow update, delete: if false;
      }
    }
    match /settings/{settingId} {
      allow read: if true;
      allow write: if admin();
    }
  }
}
